# ---------------------------------------------------------------------------
# Narrator v2 - environment reference (ARCHITECTURE.md section 18)
# Copy to .env for local dev. NEVER commit real secrets.
# In production these live in the Coolify env tab (mark secrets as secret).
# ---------------------------------------------------------------------------

# --- Auth (REQUIRED) ---------------------------------------------------------
# Comma-separated API keys accepted by the API. Generate with: openssl rand -hex 24
API_KEYS=change-me-dev-key

# --- Infra -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
# OpenAI-compatible TTS engine base URL (the in-repo tts service)
TTS_BASE_URL=http://tts:8880/v1

# --- Synthesis defaults ------------------------------------------------------
TTS_VOICE=af_heart
TTS_SPEED=1.0
SYNTH_CONCURRENCY=2
ONNX_INTRA_OP=2
CHUNK_TARGET_CHARS=1200
CHUNK_HARD_MAX=2000
CACHE_MAX_GB=5
NON_ENGLISH_POLICY=skip_warn

# --- Processing --------------------------------------------------------------
# explainer (Gemini map-reduce) | verbatim
PROCESSOR_DEFAULT=explainer
EXPLAINER_TARGET_MINUTES=30
# Required only when the explainer processor is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Scheduling / limits -----------------------------------------------------
FAST_LANE_MAX_MINUTES=20
MAX_INPUT_CHARS=3000000
MAX_ACTIVE_JOBS=2
MAX_FAILED_CHUNK_PCT=1
RETENTION_DAYS=7

# --- Storage -----------------------------------------------------------------
# local (dev / initial deploy) | gdrive (production delivery)
STORAGE_BACKEND=local
GDRIVE_ROOT_FOLDER_NAME=Narrator
# Required only when STORAGE_BACKEND=gdrive. Obtain via scripts/gdrive_auth.py.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# --- Webhooks (optional) -----------------------------------------------------
# When set, terminal job states POST an HMAC-SHA256 signed payload.
WEBHOOK_SECRET=

# --- TTS service model download (used only by services/tts) ------------------
# Defaults point at the official kokoro-onnx v1.0 release assets.
MODEL_URL=
VOICES_URL=
